#: i18n-module.php:200
msgid "Register now &raquo;"
msgstr "Regístrate ahora &raquo;"

#: i18n-module.php:197
msgid "Translation of %s"
msgstr "Traducción de %s"

#: i18n-module.php:174
msgid "You're using WordPress in a language we don't support yet. We'd love for %2$s to be translated in that language too, but unfortunately, it isn't right now. You can change that! Register at %4$s to help translate it!"
msgstr "Esta usando WordPress en un idioma que aún no está disponible. Nos encantaría tener %2$s traducido a este idioma también pero, desafortunadamente, aún no lo tenemos. ¡Su puede cambiar esto!. ¡Regístrase en %4$s para ayudarnos a traducirlo!."

#: i18n-module.php:172
msgid "You're using WordPress in %1$s. While %2$s has been translated to %1$s for %3$d%%, it's not been shipped with the plugin yet. You can help! Register at %4$s to help complete the translation to %1$s!"
msgstr "Está usando WordPress en  %1$s. Mientras que %2$ ha sido traducido al %1$s un %3$d%%, aún no ha sido añadido al plugin. ¡Puede ayudar!. Regístrase en %4$s para ayudar a completar la traducción al %1$s!"

#: i18n-module.php:170
msgid "As you can see, there is a translation of this plugin in %1$s. This translation is currently %3$d%% complete. We need your help to make it complete and to fix any errors. Please register at %4$s to help complete the translation to %1$s!"
msgstr "Como puede ver, hay una traducción de este plugin en %1$s. Esta traducción está actualmente complata al %3$d%% . Necesitamos su ayuda para completarla y corregir cualquier error. Por favor, resgístrase en %4$s para ayudar a completar la traducción de %1$s!"

