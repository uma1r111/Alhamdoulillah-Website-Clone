#: bctt_options.php:203
msgid "Subscribe"
msgstr "Iscriviti"

#: bctt_options.php:151
msgid "Want Premium styles? Add the <a href=%s>Premium Styles add-on</a> today!"
msgstr "Se vuoi utilizzare gli stili premium, clicca su <a href=%s>Premium Styles add-on</a>"

#: bctt_options.php:142
msgctxt "label for checkbox on settings screen"
msgid "Use Premium Styles?"
msgstr "Utilizza stili Premium?"

#: i18n-module.php:200
msgid "Register now &raquo;"
msgstr "Registrati ora &raquo;"

#: i18n-module.php:197
msgid "Translation of %s"
msgstr "Traduzione di %s"

#: i18n-module.php:174
msgid "You're using WordPress in a language we don't support yet. We'd love for %2$s to be translated in that language too, but unfortunately, it isn't right now. You can change that! Register at %4$s to help translate it!"
msgstr "Stai usando Wordpress in un linguaggio che ancora non è supportato. Ci piacerebbe davvero %2$s che venisse fosse tradotto anche in quel linguaggio, ma sfortunatamente, non lo è ancora. Tu puoi cambiare tutto questo! Registrati a %4$s per aiutare a tradurlo!"

#: i18n-module.php:172
msgid "You're using WordPress in %1$s. While %2$s has been translated to %1$s for %3$d%%, it's not been shipped with the plugin yet. You can help! Register at %4$s to help complete the translation to %1$s!"
msgstr "Stai usando WordPress in %1$s. Finch&egrave; %2$s non sar&agrave; tradotto in %1$s al %3$d%%, non sar&agrave; distribuito con il plugin. &Egrave; possibile contribuire! Registrati a %4$s per aiutare a completare la traduzione al %1$s!"

#: i18n-module.php:170
msgid "As you can see, there is a translation of this plugin in %1$s. This translation is currently %3$d%% complete. We need your help to make it complete and to fix any errors. Please register at %4$s to help complete the translation to %1$s!"
msgstr "Come potete vedere, c'è una traduzione di questo plugin in %1$s. Questa traduzione è attualmente completa al %3$d%%. Abbiamo bisogno del vostro aiuto per completarla e per correggere eventuali errori. Registratevi presso %4$s per aiutare a completare la traduzione in %1$s!"

