<Chapter ChapterID="109" ChapterName="Les infidèles (Al-Kafiroune)">
	<Verse VerseID="1"><![CDATA[Dis : "Ô vous les infidèles ! ]]></Verse>
	<Verse VerseID="2"><![CDATA[Je n'adore pas ce que vous adorez. ]]></Verse>
	<Verse VerseID="3"><![CDATA[Et vous n'êtes pas adorateurs de ce que j'adore. ]]></Verse>
